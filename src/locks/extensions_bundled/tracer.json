{
  "format": 1,
  "name": "tracer",
  "description": "the TRACER method, where a repository keeps it: its files, flows and CORRECT lines, read as its template writes them",
  "when": {"exists": "docs/tracer"},
  "method": {
    "folder": "docs/tracer",
    "files": [["audiences.md", "Audience profiles"], ["identity.md", "Identity guideline"],
              ["floors.md", "Component floors"], ["anti-patterns.md", "Anti-pattern catalogue"]],
    "flows": "flows",
    "capabilities": "capabilities.md",
    "slices": "slices.md",
    "criterion": "CORRECT"
  }
}
